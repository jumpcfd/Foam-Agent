FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    #includeFunc wallShearStress

    plateWallShearStress
    {
        type                 surfaces;
        libs                 ("libsampling.so");
        writeControl         writeTime;
        surfaceFormat        raw;
        fields               (wallShearStress);
        interpolationScheme  cell;
        surfaces
        (
            plate
            {
                type         patch;
                patches      (plate);
                triangulate  false;
            }
        );
    }

    #includeFunc graphUniform
    (
        funcName=profile_x0p2,
        start=(0.2 0 0),
        end=(0.2 0.05 0),
        nPoints=300,
        axis=y,
        U
    )

    #includeFunc graphUniform
    (
        funcName=profile_x0p4,
        start=(0.4 0 0),
        end=(0.4 0.05 0),
        nPoints=300,
        axis=y,
        U
    )

    #includeFunc graphUniform
    (
        funcName=profile_x0p6,
        start=(0.6 0 0),
        end=(0.6 0.05 0),
        nPoints=300,
        axis=y,
        U
    )

    #includeFunc graphUniform
    (
        funcName=profile_x0p8,
        start=(0.8 0 0),
        end=(0.8 0.05 0),
        nPoints=300,
        axis=y,
        U
    )

    #includeFunc graphUniform
    (
        funcName=profile_x1p0,
        start=(1.0 0 0),
        end=(1.0 0.05 0),
        nPoints=300,
        axis=y,
        U
    )
}

